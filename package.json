{
  "name": "openclaw-herdr",
  "version": "0.1.0",
  "description": "OpenClaw plugin that drives coding agents running in Herdr panes through Herdr's native socket API: send prompts from chat, get woken when the agent finishes or blocks.",
  "license": "MIT",
  "type": "module",
  "private": true,
  "homepage": "https://github.com/dobbygl/openclaw-herdr#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/dobbygl/openclaw-herdr.git"
  },
  "bugs": {
    "url": "https://github.com/dobbygl/openclaw-herdr/issues"
  },
  "keywords": [
    "openclaw",
    "openclaw-plugin",
    "herdr",
    "claude-code",
    "codex",
    "coding-agent",
    "terminal"
  ],
  "engines": {
    "node": ">=22.0.0"
  },
  "files": [
    "dist/src",
    "openclaw.plugin.json",
    "README.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "npm run build && node dist/scripts/smoke.js",
    "validate": "openclaw plugins validate --json",
    "check": "npm run typecheck && npm test && npm run build"
  },
  "openclaw": {
    "extensions": [
      "./dist/src/index.js"
    ],
    "compat": {
      "pluginApi": ">=2026.9.2"
    },
    "build": {
      "openclawVersion": "2026.9.2"
    }
  },
  "peerDependencies": {
    "openclaw": ">=2026.9.2"
  },
  "dependencies": {
    "typebox": "^1.3.17"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "openclaw": "2026.9.5",
    "typescript": "^5.9.0",
    "vitest": "^4.1.5"
  }
}
